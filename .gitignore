# Data — never commit raw images. Redistribution terms differ per dataset, and files are too large.
data/raw/**
!data/raw/.gitkeep

# Processed CSVs/JSON (labels, splits, weights) ARE committed — small, no image
# bytes inside them, safe. Only the verification preview images are excluded.
data/processed/preprocessed_samples/*.png

# Model checkpoints / weights
*.pt
*.pth
*.ckpt
outputs/checkpoints/**

# Local config with personal paths
configs/paths.local.yaml

# Environment
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db

# Logs (keep reports, drop verbose logs)
outputs/logs/*.log